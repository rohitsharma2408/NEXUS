# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
# --default-timeout and --retries make pip tolerant of a slow/unstable connection:
# a single stalled chunk (seen failing at ~84 kB/s mid-download) no longer kills the
# whole build — pip waits longer per attempt and retries more times before giving up.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --default-timeout=30 --retries 10 -r requirements.txt
# Short timeout + many retries: a stalled download fails fast and retries instead of hanging
# (a 1000s timeout caused a corrupted xgboost download). Cache mount keeps finished downloads.
COPY project1_agentic/ ./project1_agentic/
COPY project2_analytics/ ./project2_analytics/
COPY evaluation/ ./evaluation/
COPY conftest.py ./conftest.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

CMD ["uvicorn", "project1_agentic.api.main:app", "--host", "0.0.0.0", "--port", "8000"]

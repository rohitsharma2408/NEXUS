# syntax=docker/dockerfile:1
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq-dev gcc && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --default-timeout=30 --retries 10 -r requirements.txt
# Short timeout + many retries: a stalled download fails fast and retries instead of hanging
# (a 1000s timeout caused a corrupted xgboost download). Cache mount keeps finished downloads.o
COPY project2_analytics/ ./project2_analytics/

ENV PYTHONUNBUFFERED=1
EXPOSE 8501

CMD ["streamlit", "run", "project2_analytics/dashboard/app.py", "--server.address=0.0.0.0", "--server.port=8501"]

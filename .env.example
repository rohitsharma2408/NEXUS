# --- Database (local docker-compose defaults) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=nexus_db
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://nexus_user:change_me@postgres:5432/nexus_db

# Read-only role used by the agentic SQL layer (created in schema_star.sql)
NEXUS_READONLY_USER=nexus_readonly
NEXUS_READONLY_PASSWORD=change_me_too
READONLY_DATABASE_URL=postgresql://nexus_readonly:change_me_too@postgres:5432/nexus_db

# --- LLM provider (used by the agents) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# --- AWS (for cloud deployment) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
S3_DATA_BUCKET=nexus-datalake-CHANGE_ME
ECR_REPO_API=nexus-api
ECR_REPO_DASHBOARD=nexus-dashboard

# --- App ---
NEXUS_ENV=local
API_PORT=8000
DASHBOARD_PORT=8501
